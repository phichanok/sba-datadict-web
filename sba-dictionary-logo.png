@import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap");

:root, :root[data-theme="ocean"] {
  --bg:#f4f7fb; --panel:#fff; --panel-2:#edf4fb; --sidebar:#102a43; --sidebar-2:#173f63;
  --line:#d9e4ee; --line-soft:#edf2f6; --text:#14283b; --muted:#60758a; --accent:#2e9eff;
  --accent-strong:#0c79d8; --accent-soft:#e6f3ff; --accent-2:#1769aa; --warning:#e69a23;
  --shadow:0 14px 45px rgba(19,55,85,.09);
}
:root[data-theme="violet"] { --bg:#f7f5fc; --panel:#fff; --panel-2:#f2edff; --sidebar:#241c3b; --sidebar-2:#36285a; --line:#e5def1; --line-soft:#f0ecf6; --text:#251e33; --muted:#7e728f; --accent:#7c4dff; --accent-strong:#6134db; --accent-soft:#eee8ff; --accent-2:#d9469f; --warning:#df8d22; --shadow:0 14px 45px rgba(73,45,115,.1); }
:root[data-theme="sunset"] { --bg:#fff8f3; --panel:#fffdfb; --panel-2:#fff0e7; --sidebar:#40231f; --sidebar-2:#5a3028; --line:#f1ddd2; --line-soft:#f7ebe4; --text:#382621; --muted:#8b746c; --accent:#ef654f; --accent-strong:#d64b36; --accent-soft:#ffebe5; --accent-2:#dc8a14; --warning:#d37e10; --shadow:0 14px 45px rgba(112,60,43,.1); }
:root[data-theme="midnight"] { --bg:#07101b; --panel:#0d1926; --panel-2:#132233; --sidebar:#08131f; --sidebar-2:#102536; --line:#203348; --line-soft:#17283a; --text:#e7eff7; --muted:#8196aa; --accent:#35d5b1; --accent-strong:#58e6c5; --accent-soft:#12382f; --accent-2:#62a8ff; --warning:#ffc261; --shadow:0 14px 48px rgba(0,0,0,.25); }

*{box-sizing:border-box} html{background:var(--bg)} body{margin:0;background:var(--bg);color:var(--text);font-family:"IBM Plex Sans Thai","Noto Sans Thai",Arial,sans-serif;font-size:16px} button,input,select,textarea{font:inherit} button{color:inherit} svg{width:1.2rem;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}.app-shell{min-height:100vh}
.sidebar{background:linear-gradient(180deg,var(--sidebar),color-mix(in srgb,var(--sidebar) 86%,#000));color:#eef7ff;display:flex;flex-direction:column;height:100vh;left:0;position:fixed;top:0;width:284px;z-index:10}.brand{align-items:center;border-bottom:1px solid rgba(255,255,255,.1);display:flex;gap:14px;min-height:92px;padding:16px 18px}.brand-logo{align-items:center;background:linear-gradient(145deg,#68c4ff 0%,#2e9eff 58%,#0c79d8 100%);border:1px solid rgba(255,255,255,.24);border-radius:13px;box-shadow:inset 0 1px 0 rgba(255,255,255,.24),0 7px 18px rgba(0,0,0,.18);color:#fff;display:flex;flex:0 0 48px;font-size:13px;font-weight:700;height:48px;justify-content:center;letter-spacing:-.02em;width:48px}.brand-copy{min-width:0}.brand-copy strong{color:#fff;display:block;font-size:16px;font-weight:700;letter-spacing:.01em;line-height:1.2;white-space:nowrap}.brand small{color:#9ebbd2;display:block;font-size:9px;font-weight:500;letter-spacing:.1em;line-height:1.5;margin-top:7px;white-space:nowrap}
.sidebar-label{align-items:center;color:rgba(255,255,255,.5);display:flex;font-family:var(--font-geist-mono);font-size:10px;justify-content:space-between;letter-spacing:.1em;padding:22px 18px 10px}.sidebar-label span:last-child{background:rgba(255,255,255,.1);border-radius:8px;color:#fff;padding:4px 8px}.table-list{flex:1;overflow-y:auto;padding:0 10px 14px}.table-list::-webkit-scrollbar{width:5px}.table-list::-webkit-scrollbar-thumb{background:rgba(255,255,255,.18);border-radius:6px}.table-list button{align-items:center;background:transparent;border:0;border-radius:9px;cursor:pointer;display:grid;gap:7px;grid-template-columns:52px 1fr auto;padding:10px 9px;text-align:left;width:100%}.table-list button:hover{background:rgba(255,255,255,.07)}.table-list button.active{background:var(--accent);box-shadow:0 8px 18px rgba(0,0,0,.12)}.table-code{color:#fff;font-family:var(--font-geist-mono);font-size:12px;font-weight:700}.table-meta{color:rgba(255,255,255,.55);font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.table-list .active .table-meta{color:rgba(255,255,255,.82)}.table-list b{color:rgba(255,255,255,.45);font-family:var(--font-geist-mono);font-size:10px}.table-list .active b{color:#fff}.sidebar-footer{align-items:center;border-top:1px solid rgba(255,255,255,.1);display:flex;gap:10px;padding:17px 18px}.sidebar-footer strong,.sidebar-footer small{display:block}.sidebar-footer strong{font-size:11px}.sidebar-footer small{color:rgba(255,255,255,.48);font-size:10px;margin-top:3px}.status-dot{background:#59efc6;border-radius:50%;box-shadow:0 0 12px #59efc6;height:8px;width:8px}
.workspace{margin-left:284px;padding:0 36px 64px}.topbar{align-items:center;display:flex;justify-content:space-between;min-height:138px;padding:28px 0}.eyebrow{color:var(--accent-strong);font-size:11px;font-weight:700;letter-spacing:.11em;margin:0 0 8px}.topbar h1{font-size:clamp(34px,3vw,44px);font-weight:700;letter-spacing:-.035em;line-height:1;margin:0}.subtitle{color:var(--muted);font-size:15px;margin:11px 0 0}.actions{align-items:center;display:flex;gap:9px}.action{align-items:center;border:1px solid var(--line);border-radius:10px;cursor:pointer;display:inline-flex;font-size:14px;font-weight:600;gap:7px;justify-content:center;min-height:44px;padding:11px 15px;transition:.18s}.action:hover{transform:translateY(-1px)}.action.secondary{background:var(--panel);box-shadow:0 3px 12px rgba(0,0,0,.03)}.action.primary{background:var(--accent);border-color:var(--accent);box-shadow:0 8px 22px color-mix(in srgb,var(--accent) 25%,transparent);color:#fff}
.access-badge{border:1px solid var(--line);border-radius:999px;font-size:11px;font-weight:700;padding:9px 12px}.access-badge.viewer{background:var(--panel-2);color:var(--muted)}.account-link{background:transparent;border:0;border-left:1px solid var(--line);color:var(--text);cursor:pointer;display:flex;flex-direction:column;font-size:10px;margin-left:3px;max-width:180px;padding-left:12px;text-align:left;text-decoration:none}.account-link span{color:var(--accent-strong);font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.account-link strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.account-link:hover strong{text-decoration:underline}
.search-panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:18px}.command-input{align-items:center;background:var(--panel-2);border:1px solid transparent;border-radius:12px;display:flex;min-height:62px;padding:0 18px}.command-input:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 10%,transparent)}.command-input svg{color:var(--accent);flex:0 0 auto;margin-right:14px;width:21px}.command-input input{background:transparent;border:0;color:var(--text);flex:1;font-size:15px;outline:0;width:100%}.command-input input::placeholder{color:var(--muted)}.clear-button,.reset-button{background:transparent;border:1px solid var(--line);border-radius:8px;color:var(--muted);cursor:pointer;font-size:10px;padding:8px 10px}.filters{align-items:flex-end;display:flex;gap:12px;margin-top:14px}.filters label{color:var(--muted);display:flex;flex-direction:column;font-family:var(--font-geist-mono);font-size:9px;gap:6px;letter-spacing:.1em}.filters select,.form-grid select,.form-grid input,.form-grid textarea{background:var(--panel);border:1px solid var(--line);border-radius:9px;color:var(--text);outline:none;padding:10px 12px}.filters select{min-width:165px}.filters select:focus,.form-grid input:focus,.form-grid select:focus,.form-grid textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 9%,transparent)}.reset-button{margin-left:auto;padding:11px 12px}
.metrics{display:grid;gap:14px;grid-template-columns:repeat(3,1fr);margin-top:16px}.metrics article{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:17px 19px}.metrics span,.metrics small{color:var(--muted);display:block}.metrics span{font-family:var(--font-geist-mono);font-size:9px;letter-spacing:.1em}.metrics strong{display:block;font-family:var(--font-geist-mono);font-size:28px;margin:7px 0 3px}.metrics strong.accent{color:var(--accent-strong)}.metrics small{font-size:11px}
.table-summary{align-items:flex-start;background:var(--accent-soft);border:1px solid color-mix(in srgb,var(--accent) 25%,var(--line));border-radius:13px;display:flex;gap:15px;margin-top:14px;padding:18px}.table-badge{background:var(--accent);border-radius:8px;color:#fff;flex:none;font-family:var(--font-geist-mono);font-size:12px;font-weight:800;padding:9px 11px}.table-summary h2{font-size:17px;margin:0}.table-summary p{color:var(--muted);font-size:12px;line-height:1.7;margin:5px 0 0}.record-actions{display:flex;gap:8px;margin-left:auto}.edit-button,.delete-button{background:var(--panel);border:1px solid color-mix(in srgb,var(--accent) 42%,var(--line));border-radius:9px;color:var(--accent-strong);cursor:pointer;font-size:11px;font-weight:700;padding:9px 12px;white-space:nowrap}.edit-button:hover{background:var(--accent);color:#fff}.delete-button{border-color:color-mix(in srgb,#ef4444 42%,var(--line));color:#dc2626}.delete-button:hover{background:#dc2626;color:#fff}.delete-button:disabled,.action:disabled{cursor:not-allowed;opacity:.55}.drawer-title .record-actions{margin:12px 0 0}
.result-panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);margin-top:14px;overflow:hidden}.result-heading{align-items:center;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;padding:16px 18px}.result-heading span{color:var(--muted);font-family:var(--font-geist-mono);font-size:9px;letter-spacing:.12em}.result-heading p{font-size:13px;margin:5px 0 0}.result-heading .result-count{background:var(--accent-soft);border-radius:8px;color:var(--accent-strong);font-weight:700;padding:7px 9px}.data-grid{max-height:650px;overflow:auto}.grid-row{align-items:stretch;background:transparent;border:0;border-bottom:1px solid var(--line-soft);cursor:pointer;display:grid;grid-template-columns:90px minmax(140px,.8fr) 130px 70px minmax(320px,2.2fr);min-width:860px;padding:0;text-align:left;width:100%}.grid-row>span{align-items:center;border-right:1px solid var(--line-soft);display:flex;min-width:0;padding:13px 12px}.grid-row>span:last-child{border-right:0}.grid-row:not(.grid-header):hover{background:var(--panel-2)}.grid-header{background:var(--panel-2);color:var(--muted);cursor:default;font-family:var(--font-geist-mono);font-size:9px;letter-spacing:.09em;position:sticky;top:0;z-index:2}.table-pill{color:var(--accent-2);font-family:var(--font-geist-mono);font-size:11px}.field-name{font-family:var(--font-geist-mono);font-size:12px;font-weight:700}.grid-row code{color:var(--accent-2);font-family:var(--font-geist-mono);font-size:11px}.grid-row i{color:var(--muted);font-family:var(--font-geist-mono);font-size:11px;font-style:normal}.grid-row i.key-active{color:var(--warning)}.description-cell{align-items:flex-start!important;flex-direction:column;gap:4px}.description-cell strong{font-size:12px;font-weight:400;line-height:1.55}.description-cell small{color:var(--muted);font-size:10px;line-height:1.45}.empty-state{align-items:center;color:var(--muted);display:flex;flex-direction:column;padding:70px 20px;text-align:center}.empty-state svg{width:30px}.empty-state h3{color:var(--text);font-size:16px;margin:14px 0 5px}.empty-state p{font-size:12px;margin:0}
.modal-backdrop,.drawer-backdrop{background:rgba(4,10,17,.62);inset:0;position:fixed;z-index:40}.modal-backdrop{align-items:center;display:flex;justify-content:center;padding:20px;z-index:50}.modal-card{background:var(--panel);border:1px solid var(--line);border-radius:20px;box-shadow:0 28px 90px rgba(0,0,0,.25);max-height:92vh;max-width:680px;overflow:auto;padding:28px;position:relative;width:100%}.modal-close,.drawer-close{background:var(--panel-2);border:1px solid var(--line);border-radius:9px;cursor:pointer;font-size:20px;height:36px;position:absolute;right:22px;top:22px;width:36px}.modal-card h2{font-size:25px;margin:5px 0}.modal-lead{color:var(--muted);font-size:12px;margin:8px 0 22px}.form-grid{display:grid;gap:15px;grid-template-columns:1fr 1fr}.form-grid label{color:var(--muted);display:flex;flex-direction:column;font-size:11px;font-weight:650;gap:7px}.form-grid .wide{grid-column:1/-1}.form-grid textarea{resize:vertical}.form-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:22px}.form-error{color:#e24f4f;font-size:12px}.theme-grid{display:grid;gap:12px;grid-template-columns:1fr 1fr}.theme-option{background:var(--panel-2);border:2px solid transparent;border-radius:13px;cursor:pointer;padding:15px;text-align:left}.theme-option.selected{border-color:var(--accent)}.theme-option strong,.theme-option small{display:block}.theme-option strong{font-size:13px;margin-top:12px}.theme-option small{color:var(--muted);font-size:10px;margin-top:4px}.swatches{display:flex}.swatches i{border:2px solid var(--panel);border-radius:50%;height:28px;margin-right:-6px;width:28px}.toast{background:var(--sidebar);border-radius:10px;bottom:24px;box-shadow:var(--shadow);color:#fff;font-size:12px;left:50%;padding:13px 18px;position:fixed;transform:translateX(-50%);z-index:60}
.user-add-form{align-items:end;background:var(--panel-2);border:1px solid var(--line);border-radius:13px;display:grid;gap:12px;grid-template-columns:minmax(220px,1.4fr) minmax(180px,1fr) auto;padding:15px}.user-add-form label{color:var(--muted);display:flex;flex-direction:column;font-size:11px;font-weight:650;gap:7px}.user-add-form input,.user-add-form select,.user-controls select{background:var(--panel);border:1px solid var(--line);border-radius:9px;color:var(--text);min-height:41px;padding:9px 11px}.user-list{border:1px solid var(--line);border-radius:13px;margin-top:15px;max-height:340px;overflow:auto}.user-list article{align-items:center;border-bottom:1px solid var(--line-soft);display:flex;gap:14px;justify-content:space-between;padding:14px 15px}.user-list article:last-child{border-bottom:0}.user-list strong,.user-list small{display:block}.user-list strong{font-size:12px;overflow-wrap:anywhere}.user-list small{color:var(--muted);font-size:10px;margin-top:4px}.user-controls{align-items:center;display:flex;flex:none;gap:8px}.owner-badge{background:var(--accent-soft);border-radius:999px;color:var(--accent-strong);font-family:var(--font-geist-mono);font-size:9px;font-weight:800;padding:7px 9px}.role-note{color:var(--muted);font-size:10px;line-height:1.7;margin:14px 2px 0}.role-note b{color:var(--text)}
.detail-drawer{background:var(--panel);bottom:0;box-shadow:-20px 0 80px rgba(0,0,0,.25);max-width:92vw;overflow-y:auto;padding:28px;position:absolute;right:0;top:0;width:480px}.drawer-title{border-bottom:1px solid var(--line);padding:20px 0 24px}.drawer-title span{color:var(--accent-2);font-family:var(--font-geist-mono);font-size:11px}.drawer-title h2{font-family:var(--font-geist-mono);font-size:28px;margin:7px 0}.detail-drawer dl{display:grid;gap:10px;grid-template-columns:1fr 1fr;margin:22px 0}.detail-drawer dl div{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:15px}.detail-drawer dl .wide{grid-column:1/-1}.detail-drawer dt{color:var(--muted);font-family:var(--font-geist-mono);font-size:9px}.detail-drawer dd{font-size:13px;line-height:1.7;margin:8px 0 0}.query-hint{background:var(--accent-soft);border:1px solid color-mix(in srgb,var(--accent) 25%,var(--line));border-radius:10px;padding:16px}.query-hint span,.query-hint code{display:block}.query-hint span{color:var(--accent-strong);font-family:var(--font-geist-mono);font-size:9px}.query-hint code{font-family:var(--font-geist-mono);font-size:11px;line-height:1.6;margin:14px 0;overflow-wrap:anywhere}.query-hint button{background:transparent;border:1px solid var(--accent);border-radius:7px;color:var(--accent-strong);cursor:pointer;font-size:9px;padding:8px 10px}
.loading-screen{align-items:center;color:var(--muted);display:flex;flex-direction:column;gap:16px;justify-content:center;min-height:100vh}.loader{border:3px solid var(--line);border-top-color:var(--accent);border-radius:50%;height:30px;animation:spin .8s linear infinite;width:30px}@keyframes spin{to{transform:rotate(360deg)}}

/* Readability pass: keep dense dictionary data compact, but no longer tiny. */
.sidebar-label{font-size:11px}.table-list button{padding:11px 10px}.table-code{font-size:13px}.table-meta{font-size:12px}.table-list b{font-size:11px}.sidebar-footer strong{font-size:13px}.sidebar-footer small{font-size:11px}
.command-input input{font-size:16px}.filters label{font-size:11px}.filters select{font-size:14px;min-height:44px}.clear-button,.reset-button{font-size:12px}
.metrics span{font-size:11px}.metrics strong{font-size:30px}.metrics small{font-size:13px}
.table-summary h2{font-size:19px}.table-summary p{font-size:14px}.table-badge{font-size:13px}.edit-button,.delete-button{font-size:13px}
.result-heading span{font-size:11px}.result-heading p{font-size:15px}.grid-header{font-size:10px}.table-pill,.grid-row code,.grid-row i{font-size:12px}.field-name{font-size:13px}.description-cell strong{font-size:14px}.description-cell small{font-size:12px}
.modal-card h2{font-size:28px}.modal-lead{font-size:14px}.form-grid label{font-size:13px}.form-grid input,.form-grid select,.form-grid textarea{font-size:15px;min-height:44px}.account-link{font-size:12px}.account-link span{font-size:10px}
@media(max-width:1050px){.topbar{align-items:flex-start;flex-direction:column;gap:22px}.actions{flex-wrap:wrap}.metrics{grid-template-columns:1fr 1fr 1fr}}
@media(max-width:760px){.sidebar{height:auto;position:relative;width:100%}.table-list,.sidebar-label,.sidebar-footer{display:none}.brand{min-height:70px}.workspace{margin-left:0;padding:0 16px 40px}.topbar{min-height:auto;padding:24px 0}.actions{display:grid;grid-template-columns:1fr 1fr;width:100%}.actions .primary{grid-column:1/-1}.filters{align-items:stretch;flex-direction:column}.filters select{width:100%}.reset-button{margin-left:0}.metrics{grid-template-columns:1fr}.form-grid,.theme-grid,.user-add-form{grid-template-columns:1fr}.form-grid .wide{grid-column:auto}.modal-card{padding:24px 18px}.modal-close{right:16px;top:16px}.user-list article{align-items:flex-start;flex-direction:column}.user-controls{width:100%}.user-controls select{flex:1}}
